{
    "name": "drupal/cms",
    "version": "1.2.3",
    "description": "Drupal CMS is a ready-to-use platform built on Drupal core, offering smart defaults to get started quickly and enterprise-grade tools for marketers, designers, and content creators.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/cms",
    "support": {
        "docs": "https://new.drupal.org/docs/drupal-cms",
        "chat": "https://drupal.org/node/314178"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
  "autoload": {
    "psr-4": {
      "Drupal\\mel_auth_claim\\": "web/modules/custom/mel_auth_claim/src/"
        }
      },
    "require": {
        "composer/installers": "^2.3",
        "drupal/address_map_link": "2.x-dev@dev",
        "drupal/automatic_updates": "^4.0",
        "drupal/captcha": "2.0.9",
        "drupal/coffee": "^2.0",
        "drupal/commerce": "^3.1",
        "drupal/commerce_cart": "^3",
        "drupal/commerce_checkout": "^3",
        "drupal/commerce_order": "^3",
        "drupal/commerce_payment": "^3",
        "drupal/commerce_price": "^3",
        "drupal/commerce_product": "^3",
        "drupal/commerce_stock": "^3",
        "drupal/commerce_stripe": "^2.1",
        "drupal/conditional_fields": "4.x-dev@dev",
        "drupal/config_ignore": "^3.3",
        "drupal/core": "^11.2",
        "drupal/core-composer-scaffold": "^11.2",
        "drupal/core-project-message": "^11.2",
        "drupal/core-recipe-unpack": "^11.2",
        "drupal/core-recommended": "^11.2",
        "drupal/dashboard": "^2.0",
        "drupal/drupal_cms_accessibility_tools": "^1.2",
        "drupal/drupal_cms_ai": "^1.2",
        "drupal/drupal_cms_analytics": "^1.2",
        "drupal/drupal_cms_blog": "^1.2",
        "drupal/drupal_cms_case_study": "^1.2",
        "drupal/drupal_cms_events": "^1.2",
        "drupal/drupal_cms_forms": "^1.2",
        "drupal/drupal_cms_news": "^1.2",
        "drupal/drupal_cms_page": "^1.2",
        "drupal/drupal_cms_person": "^1.2",
        "drupal/drupal_cms_project": "^1.2",
        "drupal/drupal_cms_seo_tools": "^1.2",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/easy_email_theme": "^1.0",
        "drupal/eca": "2.1.13",
        "drupal/field_group": "^4.0",
        "drupal/gin": "^5.0",
        "drupal/inline_entity_form": "^3.0@rc",
        "drupal/jquery_ui": "^1.7",
        "drupal/linkit": "7.0.8",
        "drupal/mailsystem": "^4.5",
        "drupal/paragraphs": "1.x-dev",
        "drupal/profile": "^1.12",
        "drupal/recipe_installer_kit": "^1-alpha6@alpha",
        "drupal/redirect": "^1.11",
        "drupal/smtp": "^1.4",
        "drupal/social_auth": "^4.1",
        "drupal/social_auth_apple": "^2.0",
        "drupal/social_auth_facebook": "^4.0",
        "drupal/social_auth_google": "^4.0",
        "drupal/symfony_mailer_lite": "^2.0",
        "drupal/token": "^1.15",
        "drupal/twig_tweak": "^3.4",
        "drupal/views_infinite_scroll": "^2.0",
        "drupal/webform": "^6.3",
        "guzzlehttp/guzzle": "^7.9",
        "stripe/stripe-php": "^15.10"
    },
    "require-dev": {
        "drupal/core-dev": "^11",
        "drupal/devel": "^5.4",
        "drush/drush": "^13.6",
        "mglaman/phpstan-drupal": "^2.0"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "drupal/core-recipe-unpack": true,
            "drupal/core-vendor-hardening": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "./drush/Commands/contrib/{$name}": ["type:drupal-drush"],
            "web/modules/custom/{$name}": ["type:drupal-custom-module"],
            "web/profiles/custom/{$name}": ["type:drupal-custom-profile"],
            "./recipes/{$name}": ["type:drupal-recipe"],
            "web/themes/custom/{$name}": ["type:drupal-custom-theme"]
        },
        "drupal-core-project-message": {
            "include-keys": ["homepage", "support"],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                   </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed Drupal CMS!    </>",
                "<bg=blue;fg=white>                                                   </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://drupal.org/support",
                "  * Get involved with the Drupal community: https://drupal.org/getting-involved"
            ]
        }
    }
}
