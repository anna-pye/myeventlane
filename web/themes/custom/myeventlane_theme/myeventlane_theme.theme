use Drupal\commerce_product\Entity\ProductVariationInterface;
use Drupal\commerce_price\Price;
use Drupal\Core\Render\Element;

function myeventlane_theme_preprocess_commerce_product(&$vars) {
  // Only in add_to_cart view mode.
  if (($vars['elements']['#view_mode'] ?? '') !== 'add_to_cart') {
    return;
  }
  if (isset($vars['content']['variations']) && is_array($vars['content']['variations'])) {
    $vars['content']['variations']['#attributes']['class'][] = 'mel-variations-form';
  }
}

/**
 * Implements hook_preprocess_commerce_product_add_to_cart_form().
 */
function myeventlane_theme_preprocess_commerce_product_add_to_cart_form(array &$vars): void {
  $form = &$vars['form'];
  $vars['mel'] = [
    'title' => NULL,
    'variation_title' => NULL,
    'price' => NULL,
    'remaining' => NULL,
  ];

  // Try to resolve a single selected variation for nicer labels/price.
  $variation = NULL;

  // Case 1: products with a single variation element (common for tickets).
  if (isset($form['purchased_entity']['widget']['0']['variation'])) {
    $variation_element = $form['purchased_entity']['widget']['0']['variation'];
    if (!empty($variation_element['#default_value']) && $variation_element['#default_value'] instanceof ProductVariationInterface) {
      $variation = $variation_element['#default_value'];
    }
    // Label cleanup.
    $form['purchased_entity']['#title'] = t('Ticket type');
  }

  // Case 2: radios/select for multiple variations.
  if (!$variation && isset($form['purchased_entity'])) {
    // We can’t know which variation until the user selects; use first available for display hints.
    $variation = _myeventlane_theme_first_variation_from_element($form['purchased_entity']);
    $form['purchased_entity']['#title'] = t('Ticket type');
  }

  // Quantity label tidy.
  if (isset($form['quantity'])) {
    $form['quantity']['#title'] = t('Quantity');
  }

  // Extract display data.
  if ($variation instanceof ProductVariationInterface) {
    $vars['mel']['variation_title'] = $variation->label();

    // Price: commerce_price stores as Price object on the field 'price'.
    if ($variation->hasField('price') && !$variation->get('price')->isEmpty()) {
      /** @var \Drupal\commerce_price\Price $price */
      $price = $variation->get('price')->first()->toPrice();
      $vars['mel']['price'] = $price instanceof Price ? $price->__toString() : NULL;
    }

    // Remaining tickets hint (if stock contrib or custom field exists).
    $remaining_text = _myeventlane_theme_ticket_remaining_text($variation);
    if ($remaining_text) {
      $vars['mel']['remaining'] = $remaining_text;
    }
  }

  // Page title → ticket card title (clean, not verbose).
  // If an Event node title is in context, prefer that.
  if (\Drupal::routeMatch()->getParameter('node')?->bundle() === 'event') {
    $event = \Drupal::routeMatch()->getParameter('node');
    $vars['mel']['title'] = $event->label();
  }
}
