/**
 * ------------------------------------------------------------
 * hook_preprocess_node()
 * - Exposes 'type' (rsvp/paid) on full event nodes
 * - Adds ticket form stubs for paid events
 * ------------------------------------------------------------
 */

/**
 * @file
 * Theme hooks for MyEventLane.
 */

/**
 * Implements hook_preprocess_node().
 */
function myeventlane_theme_preprocess_node(array &$variables) {
  $node = $variables['node'] ?? NULL;
  if (!$node || $node->bundle() !== 'event') {
    return;
  }

  // ---------------------------
  // Registration mode (existing)
  // ---------------------------
  $mode = 'none';
  if ($node->hasField('field_ticket_type') && !$node->get('field_ticket_type')->isEmpty()) {
    // Expected values: 'rsvp' or 'paid'.
    $mode = (string) $node->get('field_ticket_type')->value;
  }
  else {
    if ($node->hasField('field_product_target') && !$node->get('field_product_target')->isEmpty()) {
      $mode = 'paid';
    }
    elseif ($node->hasField('field_rsvp_enabled') && (int) $node->get('field_rsvp_enabled')->value === 1) {
      $mode = 'rsvp';
    }
  }

  // Compute availability flags.
  $has_tickets = FALSE;
  if ($mode === 'paid' && $node->hasField('field_product_target') && !$node->get('field_product_target')->isEmpty()) {
    $product = $node->get('field_product_target')->entity;
    if ($product && method_exists($product, 'getVariations')) {
      $variations = $product->getVariations();
      $has_tickets = !empty($variations);
    }
  }

  $variables['registration_mode'] = $mode;   // 'paid' | 'rsvp' | 'none'
  $variables['has_tickets'] = $has_tickets;

  // Back-compat for existing template checks.
  $variables['type'] = $mode; // you were using {% if type == 'rsvp' %} etc.

  // ---------------------------
  // Boost flags (new)
  // ---------------------------
  $now = \Drupal::time()->getRequestTime();

  $promoted = FALSE;
  if ($node->hasField('field_promoted') && !$node->get('field_promoted')->isEmpty()) {
    $promoted = (bool) ((int) $node->get('field_promoted')->value);
  }

  $expires_ts = 0;
  if ($node->hasField('field_promo_expires') && !$node->get('field_promo_expires')->isEmpty()) {
    $expires_val = (string) $node->get('field_promo_expires')->value;
    if ($expires_val) {
      try {
        $dt = new \DateTimeImmutable($expires_val, new \DateTimeZone('UTC'));
        $expires_ts = $dt->getTimestamp();
      }
      catch (\Throwable $e) {
        $expires_ts = 0;
      }
    }
  }

  $is_boosted = $promoted && ($expires_ts > $now);
  $days_left = $is_boosted ? (int) ceil(($expires_ts - $now) / 86400) : 0;

  // Expose to Twig.
  $variables['mel_is_boosted'] = $is_boosted;
  $variables['mel_boost_expires_ts'] = $expires_ts;
  $variables['mel_boost_days_left'] = $days_left;

  // Convenience flag to hide the "Boost your event" CTA when already boosted.
  $variables['mel_hide_boost_cta'] = $is_boosted;
}


