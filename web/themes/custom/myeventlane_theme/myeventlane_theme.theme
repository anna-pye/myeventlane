/**
 * @file
 * Hooks for MyEventLane theme.
 */

/**
 * Implements hook_preprocess_html().
 *
 * Adds a body class `mel-centered-page` to specific routes so we can center
 * the content with CSS without touching page templates.
 */
function myeventlane_theme_preprocess_html(array &$variables): void {
  $route = \Drupal::routeMatch()->getRouteName();
  $targets = [
    'myeventlane_boost.boost_page',
    'user.login',
    'commerce_cart.page',
    'commerce_checkout.form',
  ];
  if (in_array($route, $targets, TRUE)) {
    // Body classes live on $variables['attributes'] in html.html.twig.
    $variables['attributes']['class'][] = 'mel-centered-page';
  }
}

/**
 * @file
 * Theme hooks for MyEventLane theme.
 */

/**
 * Add theme suggestions for specific forms.
 */
function myeventlane_theme_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  $form = $variables['element'];

  // All Commerce add-to-cart forms start with this form id.
  // Example: commerce_order_item_add_to_cart_form | commerce_order_item_add_to_cart_form_7
  if (isset($form['#form_object']) && method_exists($form['#form_object'], 'getEntity')) {
    $entity = $form['#form_object']->getEntity();
    if ($entity) {
      $bundle = $entity->bundle();

    // Optional: per-variation-bundle suggestion (e.g. ticket).
    // We try to discover the bundle safely; if not found, we skip.
    $bundle = $element['purchased_entity'][0]['#variation']->bundle() ?? NULL;
    if (is_string($bundle) && $bundle !== '') {
      $suggestions[] = 'form__commerce_order_item_add_to_cart_form__' . $bundle;
      }
    }
  }
}
