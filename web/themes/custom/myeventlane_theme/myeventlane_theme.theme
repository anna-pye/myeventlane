/**
 * Implements hook_theme_suggestions_commerce_product_alter().
 */
function myeventlane_theme_theme_suggestions_commerce_product_alter(array &$suggestions, array $variables) {
  // When rendered inside our sidebar tickets block, force the add-to-cart template.
  if (!empty($variables['elements']['#view_mode']) && $variables['elements']['#view_mode'] === 'add_to_cart') {
    $suggestions[] = 'commerce_product__add_to_cart';
  }
}

/**
 * Helper: get first variation entity from element structure.
 */
function _myeventlane_theme_first_variation_from_element(array $element): ?ProductVariationInterface {
  // Try common places Commerce renders variations.
  foreach ($element as $child) {
    if (is_array($child) && isset($child['#options'])) {
      // Options list; if #options hold entities.
      if (!empty($child['#default_value']) && $child['#default_value'] instanceof ProductVariationInterface) {
        return $child['#default_value'];
      }
      // Fallback: try first option's entity on #options__entities (if present).
      if (!empty($child['#options__entities']) && is_array($child['#options__entities'])) {
        $first = reset($child['#options__entities']);
        if ($first instanceof ProductVariationInterface) {
          return $first;
        }
      }
    }
  }
  return NULL;
}

/**
 * Helper: build "remaining tickets" string if available.
 *
 * Supports:
 *  - commerce_stock (on_hand field)
 *  - custom integer field field_ticket_stock
 * Returns localized string like "23 remaining".
 */
function _myeventlane_theme_ticket_remaining_text(ProductVariationInterface $variation): ?string {
  // commerce_stock: field 'stock' or 'on_hand' differs per setup.
  foreach (['on_hand', 'stock', 'field_ticket_stock'] as $field) {
    if ($variation->hasField($field) && !$variation->get($field)->isEmpty()) {
      $remaining = (int) $variation->get($field)->value;
      if ($remaining >= 0) {
        return \Drupal::translation()->formatPlural($remaining, '@count remaining', '@count remaining');
      }
    }
  }
  return NULL;
}


/**
 * ------------------------------------------------------------
 * Helper: build a Social Auth link if the generic route exists
 * and the provider appears configured (prevents route errors).
 * ------------------------------------------------------------
 */
function _myeventlane_theme_build_social_link(string $network): ?array {
  // Ensure the generic Social Auth route exists.
  try {
    \Drupal::service('router.route_provider')->getRouteByName('social_auth.network.redirect');
  }
  catch (\Exception $e) {
    return NULL;
  }

  // Ensure the provider is minimally configured.
  $config_map = [
    'google'   => 'social_auth_google.settings',
    'facebook' => 'social_auth_facebook.settings',
    'apple'    => 'social_auth_apple.settings',
  ];
  if (!isset($config_map[$network])) {
    return NULL;
  }
  $conf = \Drupal::config($config_map[$network]);

  // Different modules use different keys; check common ones.
  $possible_keys = ['client_id', 'app_id'];
  $has_id = FALSE;
  foreach ($possible_keys as $k) {
    $val = $conf->get($k);
    if (!empty($val) && is_string($val)) {
      $has_id = TRUE;
      break;
    }
  }
  if (!$has_id) {
    return NULL;
  }

  // Build URL using the generic route.
  try {
    $url = Url::fromRoute('social_auth.network.redirect', ['network' => $network])->toString();
  }
  catch (\Exception $e) {
    return NULL;
  }

  $labels = [
    'google'   => 'Continue with Google',
    'facebook' => 'Continue with Facebook',
    'apple'    => 'Continue with Apple',
  ];

  return [
    'provider' => $network,
    'title'    => $labels[$network] ?? ('Continue with ' . ucfirst($network)),
    'url'      => $url,
  ];
}

/**
 * ------------------------------------------------------------
 * hook_theme_suggestions_page_alter()
 * Add specific templates for auth routes:
 *   page--user--login.html.twig
 *   page--user--register.html.twig
 *   page--user--password.html.twig
 * ------------------------------------------------------------
 */
function myeventlane_theme_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  $route = \Drupal::routeMatch()->getRouteName();
  $map = [
    'user.login'    => 'page__user__login',
    'user.register' => 'page__user__register',
    'user.pass'     => 'page__user__password',
  ];
  if (isset($map[$route])) {
    $suggestions[] = $map[$route];
  }
}

/**
 * ------------------------------------------------------------
 * hook_preprocess_page()
 * - Brand vars for auth pages (logo, headings)
 * - Safe Social Auth links (only enabled providers)
 * - Homepage category terms for filter buttons
 * - Strip Social Auth blocks on auth pages (we render our own)
 * ------------------------------------------------------------
 */
function myeventlane_theme_preprocess_page(array &$variables) {
  // Route + paths.
  $route_match  = \Drupal::routeMatch();
  $route_name   = (string) $route_match->getRouteName();
  $current_path = \Drupal::service('path.current')->getPath();
  $variables['current_path'] = $current_path;
  $variables['route_name']   = $route_name;

  // Brand asset: logo served from theme.
  $theme_path = \Drupal::service('extension.list.theme')->getPath('myeventlane_theme');
  if (empty($variables['myeventlane_logo_src'])) {
    $variables['myeventlane_logo_src'] = base_path() . $theme_path . '/assets/branding/MyEventLane_Logo_Transparent.png';
  }

  // Expose site name (no Twig Tweak needed for this one).
  $variables['site_name_from_config'] = \Drupal::config('system.site')->get('name');

  // Auth page headings + toggle.
  $auth_routes = ['user.login', 'user.register', 'user.pass'];
  $variables['is_auth_page']   = in_array($route_name, $auth_routes, TRUE);
  $variables['auth_heading']   = '';
  $variables['auth_subheading']= '';

  if ($variables['is_auth_page']) {
    switch ($route_name) {
      case 'user.login':
        $variables['auth_heading'] = 'Welcome back to MyEventLane';
        $variables['auth_subheading'] = '';
        break;

      case 'user.register':
        $variables['auth_heading'] = 'Join the lane!';
        $variables['auth_subheading'] = 'Create your account to save tickets and manage your events.';
        break;

      case 'user.pass':
        $variables['auth_heading'] = "Let's reset your password";
        $variables['auth_subheading'] = 'Enter your email and we’ll send a reset link.';
        break;
    }

    // Safe Social Auth links (only if module exists AND provider configured AND route available).
    $variables['social_auth_links'] = [];
    if (\Drupal::moduleHandler()->moduleExists('social_auth')) {
      foreach (['google', 'facebook', 'apple'] as $provider) {
        if ($link = _myeventlane_theme_build_social_link($provider)) {
          $variables['social_auth_links'][] = $link;
        }
      }
    }

    // Add page-level CSS class.
    if (!empty($variables['attributes'])) {
      $variables['attributes']->addClass('is-auth-page');
    }

    // Strip injected Social Auth blocks from page content (we render our own).
    if (!empty($variables['page']['content'])) {
      foreach ($variables['page']['content'] as $k => $child) {
        if (is_array($child)) {
          if (!empty($child['#plugin_id']) && str_contains((string) $child['#plugin_id'], 'social_auth')) {
            unset($variables['page']['content'][$k]);
            continue;
          }
          if (!empty($child['#markup']) && str_contains(strip_tags((string) $child['#markup']), 'Continue with')) {
            unset($variables['page']['content'][$k]);
            continue;
          }
        }
      }
    }
  }

  // Homepage (front page or /homepage): build category terms for filter buttons.
  $path_matcher  = \Drupal::service('path.matcher');
  $alias_manager = \Drupal::service('path_alias.manager');
  $alias         = $alias_manager->getAliasByPath($current_path);

  if ($path_matcher->isFrontPage() || $alias === '/homepage') {
    // Load terms from the 'event_category' vocabulary (as full entities).
    $terms = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadTree('event_category', 0, 1, TRUE);

    $category_terms = [];
    foreach ($terms as $term) {
      $name = $term->label();
      $category_terms[] = [
        'name' => $name,
        'slug' => strtolower(preg_replace('/\s+/', '-', $name)),
        // Use canonical route; aliases will render nicely in Twig.
        'url'  => Url::fromRoute('entity.taxonomy_term.canonical', ['taxonomy_term' => $term->id()])->toString(),
      ];
    }
    $variables['event_category_terms'] = $category_terms;
  }
}

/**
 * ------------------------------------------------------------
 * My Profile page preprocess
 * Makes $user, $orders, $rsvps available in page--my-profile.html.twig.
 * ------------------------------------------------------------
 */
function myeventlane_theme_preprocess_page__my_profile(array &$variables): void {
  $account = \Drupal::currentUser();
  if (!$account->isAuthenticated()) {
    $variables['user'] = NULL;
    $variables['is_vendor'] = FALSE;
    $variables['orders'] = [];
    $variables['rsvps'] = [];
    return;
  }

  /** @var \Drupal\user\Entity\User $user */
  $user = \Drupal\user\Entity\User::load($account->id());
  $variables['user'] = $user;
  $variables['is_vendor'] = $user ? in_array('vendor', $user->getRoles(), TRUE) : FALSE;

  // Orders (Commerce).
  $order_storage = \Drupal::entityTypeManager()->getStorage('commerce_order');
  $order_ids = $order_storage->getQuery()
    ->condition('uid', $account->id())
    ->condition('state', ['completed', 'pending'], 'IN')
    ->sort('created', 'DESC')
    ->accessCheck(TRUE)
    ->execute();
  $variables['orders'] = $order_ids ? $order_storage->loadMultiple($order_ids) : [];

  // RSVPs (custom table) — guard if table doesn’t exist yet.
  $rsvps = [];
  try {
    $schema = \Drupal::database()->schema();
    if ($schema->tableExists('myeventlane_rsvp')) {
      $result = \Drupal::database()->select('myeventlane_rsvp', 'r')
        ->fields('r')
        ->condition('uid', $account->id())
        ->orderBy('created', 'DESC')
        ->execute()
        ->fetchAllAssoc('id', \PDO::FETCH_ASSOC);

      foreach ($result as $id => $row) {
        $row += [
          'event_title' => NULL,
          'event_date' => NULL,
          'event_venue' => NULL,
          'event_address' => NULL,
          'event_image_url' => NULL,
        ];

        if (!empty($row['event_nid']) && is_numeric($row['event_nid'])) {
          /** @var \Drupal\node\NodeInterface|null $event */
          $event = \Drupal\node\Entity\Node::load((int) $row['event_nid']);
          if ($event instanceof \Drupal\node\NodeInterface && $event->isPublished()) {
            $row['event'] = $event;
            $row['event_title'] = $event->label();

            if ($event->hasField('field_start_date') && !$event->get('field_start_date')->isEmpty()) {
              $row['event_date'] = $event->get('field_start_date')->value;
            }
            if ($event->hasField('field_venue') && !$event->get('field_venue')->isEmpty()) {
              $row['event_venue'] = $event->get('field_venue')->value;
            }
            if ($event->hasField('field_venue_address') && !$event->get('field_venue_address')->isEmpty()) {
              $address = $event->get('field_venue_address')->first();
              if ($address) {
                $parts = array_filter([
                  $address->getAddressLine1(),
                  $address->getLocality(),
                  $address->getAdministrativeArea(),
                  $address->getPostalCode(),
                ]);
                $row['event_address'] = $parts ? implode(', ', $parts) : NULL;
              }
            }
            if ($event->hasField('field_image') && !$event->get('field_image')->isEmpty()) {
              $image_file = $event->get('field_image')->entity;
              if ($image_file) {
                $row['event_image_url'] = \Drupal::service('file_url_generator')
                  ->generateAbsoluteString($image_file->getFileUri());
              }
            }
          }
        }
        $rsvps[] = $row;
      }
    }
  } catch (\Exception $e) {
    // Swallow errors from early schema setup.
  }
  $variables['rsvps'] = $rsvps;
}

/**
 * Implements hook_theme().
 */
function myeventlane_theme_theme($existing, $type, $theme, $path) {
  $module_path = \Drupal::service('extension.path.resolver')
    ->getPath('module', 'myeventlane_rsvp');

  return [
    'myeventlane_rsvp_submission' => [
      'variables' => [
        'rsvp' => NULL,
        'event' => NULL,
      ],
      'template' => 'rsvp-submission',
      'path' => $module_path . '/templates',
    ],
    // Thank-you page twig: myeventlane-rsvp-thankyou.html.twig
    'myeventlane_rsvp_thankyou' => [
      'variables' => [
        'event' => NULL,
        'actions' => [],
        'recommended' => NULL,
      ],
      'template' => 'myeventlane-rsvp-thankyou',
      'path' => $module_path . '/templates',
    ],
  ];
}

/**
 * ------------------------------------------------------------
 * hook_form_alter()
 * - Strips any Social Auth widgets/blocks injected into auth forms
 * - Adds brand classes/placeholders to inputs + primary CTA styling
 * ------------------------------------------------------------
 */
function myeventlane_theme_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $auth_forms = ['user_login_form', 'user_register_form', 'user_pass'];
  if (!in_array($form_id, $auth_forms, TRUE)) {
    return;
  }

  // Remove any Social Auth render arrays/libraries injected by other modules.
  foreach ($form as $key => $child) {
    if (is_array($child)) {
      if (isset($child['#theme'])) {
        $themes = (array) $child['#theme'];
        if (in_array('social_auth_links', $themes) || in_array('social_auth_login', $themes)) {
          unset($form[$key]);
          continue;
        }
      }
      if (isset($child['#attached']['library'])) {
        foreach ($child['#attached']['library'] as $lib) {
          if (strpos($lib, 'social_auth') === 0) {
            unset($form[$key]);
            break;
          }
        }
      }
    }
  }
  if (isset($form['#attached']['library'])) {
    $form['#attached']['library'] = array_values(array_filter(
      $form['#attached']['library'],
      static fn($lib) => strpos($lib, 'social_auth') !== 0
    ));
  }

  // Brand classes + placeholders.
  $form['#attributes']['class'][] = 'mel-auth-form';

  if (isset($form['actions']['submit'])) {
    $form['actions']['submit']['#attributes']['class'][] = 'mel-btn';
    $form['actions']['submit']['#attributes']['class'][] = 'mel-btn--primary';
  }

  // Remove any remaining social elements.
  foreach (array_keys($form) as $key) {
    if (stripos($key, 'social') !== FALSE) {
      unset($form[$key]);
    }
  }

  $fields = [
    'name' => 'Email address',
    'mail' => 'Email address',
    'pass' => 'Password',
    'current_pass' => 'Current password',
    'new_pass' => 'New password',
    'pass1' => 'New password',
    'pass2' => 'Confirm new password',
  ];
  foreach ($fields as $key => $placeholder) {
    if (isset($form[$key])) {
      $form[$key]['#attributes']['class'][] = 'mel-input';
      if (empty($form[$key]['#attributes']['placeholder'])) {
        $form[$key]['#attributes']['placeholder'] = $placeholder;
      }
    }
  }
}

/**
 * ------------------------------------------------------------
 * Vendor event helper (unchanged)
 * ------------------------------------------------------------
 */
function myeventlane_get_vendor_events(User $user) {
  $query = \Drupal::entityTypeManager()->getStorage('node')->getQuery();
  $nids = $query
    ->condition('type', 'event')
    ->condition('uid', $user->id())
    ->condition('status', [0, 1], 'IN')
    ->sort('created', 'DESC')
    ->accessCheck(TRUE)
    ->execute();

  $nodes = Node::loadMultiple($nids);
  $events = [];

  foreach ($nodes as $node) {
    $status = $node->isPublished() ? 'Published' : 'Pending';
    $status_class = $node->isPublished() ? 'published' : 'pending';

    $events[] = [
      'title' => $node->label(),
      'date' => $node->get('field_start_date')->date
        ? date('j M Y, g:ia', strtotime($node->get('field_start_date')->value))
        : 'No date',
      'location' => $node->get('field_location')->value ?? 'TBA',
      'status' => $status,
      'status_class' => $status_class,
      'edit_url' => $node->toUrl('edit-form')->toString(),
      'view_url' => $node->toUrl()->toString(),
    ];
  }

  return $events;
}

