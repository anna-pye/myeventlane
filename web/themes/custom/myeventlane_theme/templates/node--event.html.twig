{# web/themes/custom/myeventlane_theme/templates/node--event.html.twig #}
{{ attach_library('myeventlane_theme/event_display') }}

{# ---- Safe date values ---- #}
{% set start_raw = node.field_start_date.value ?? node.field_start_date.0.value ?? null %}
{% set end_raw   = node.field_end_date.value   ?? node.field_end_date.0.value   ?? null %}
{% set start_ts  = start_raw ? (start_raw|date('U')) : 0 %}
{% set end_ts    = end_raw   ? (end_raw|date('U'))   : 0 %}

{% set promo_expiry_ts = node.field_promo_expiry.value ? (node.field_promo_expiry.value|date('U')) : 0 %}
{% set now_ts = "now"|date('U') %}

<article class="event-full">
  <div class="event-main-layout">
    <div class="event-main-content">

      {# Event image and category badge #}
      {% if content.field_image %}
        <div class="event-image">
          {% if node.field_category.0.entity.name.value is defined %}
            <div class="event-category-badge">
              {{ node.field_category.0.entity.name.value }}
            </div>
          {% endif %}
          {{ content.field_image }}
        </div>
      {% endif %}

      <h1 class="event-title">{{ label }}</h1>

      {% if node.uid.entity %}
        <div class="event-subtitle">
          by {{ node.uid.entity.display_name.value | default(node.uid.entity.name.value | default('')) }}
        </div>
      {% endif %}

      {# Boosted Badge #}
      {% set promo_expiry_value = node.field_promo_expiry.value %}
      {% if node.field_promoted.value and promo_expiry_value %}
        <div class="event-boost-badge">
          🌟 <strong>Boosted until: {{ promo_expiry_value|date('j M Y') }}</strong>
        </div>
      {% endif %}

      <section class="event-meta">
        {% if start_ts %}
          <div class="event-meta-item">
            🗓 <strong>Starts:</strong>
            <time datetime="{{ start_raw }}">{{ start_ts|format_date('custom',"D, d M Y - H:i") }}</time>
          </div>
        {% endif %}

        {% if end_ts %}
          <div class="event-meta-item">
            🏁 <strong>Ends:</strong>
            <time datetime="{{ end_raw }}">{{ end_ts|format_date('custom',"D, d M Y - H:i") }}</time>
          </div>
        {% endif %}

        {% if node.field_venue.value %}
          <div class="event-meta-item">
            📍 <strong>Venue:</strong> {{ node.field_venue.value }}
          </div>
        {% endif %}

        {% if content.field_venue_address %}
          <div class="event-meta-item">
            🗺 <strong>Address:</strong> {{ content.field_venue_address }}
          </div>
        {% endif %}
      </section>

      {# Accessibility flags #}
      {% if node.field_accessibility is defined and node.field_accessibility|length %}
        <div class="event-accessibility">
          {% for term in node.field_accessibility %}
            {% set term_machine = term.entity.field_machine_name.value ?? term.entity.name.value|lower|replace({' ': '-'}) %}
            <span class="access-flag access-flag--{{ term_machine|clean_class }}">
              {% if term_machine == 'wheelchair' %}
                🦽
              {% elseif term_machine == 'auslan' %}
                🎤
              {% elseif term_machine in ['hearing', 'hearing-loop'] %}
                🎧
              {% else %}
                ♿
              {% endif %}
              {{ term.entity.name.value }}
            </span>
          {% endfor %}
        </div>
      {% endif %}

      {# Social Share #}
      <div class="event-share">
        <p class="share-label">Share this event:</p>
        <div class="share-buttons">
          <a href="https://www.facebook.com/sharer/sharer.php?u={{ drupal_url('<current>', {}, 'absolute') }}"
             target="_blank" rel="noopener noreferrer" class="share-btn share-facebook">Facebook</a>
          <a href="https://twitter.com/intent/tweet?text={{ label|escape('url') }}&url={{ drupal_url('<current>', {}, 'absolute') }}"
             target="_blank" rel="noopener noreferrer" class="share-btn share-twitter">X</a>
          <a href="https://www.linkedin.com/shareArticle?mini=true&url={{ drupal_url('<current>', {}, 'absolute')|escape('url') }}&title={{ label|escape('url') }}"
             target="_blank" rel="noopener noreferrer" class="share-btn share-linkedin">LinkedIn</a>
          <a href="mailto:?subject={{ label|escape('url') }}&body={{ drupal_url('<current>', {}, 'absolute') }}"
             class="share-btn share-email">Email</a>
        </div>
      </div>

      {# Description #}
      {% if node.field_event_discription.value %}
        <section class="event-description">
          <h2>About this event</h2>
          {{ node.field_event_discription.value }}
        </section>
      {% elseif content.body %}
        <section class="event-description">
          <h2>About this event</h2>
          {{ content.body }}
        </section>
      {% endif %}

      <footer class="event-footer">
        <div class="event-organizer">
          {% if node.uid.entity.user_picture.entity.uri.value is defined %}
            <div class="organizer-avatar">
              <img src="{{ file_url(node.uid.entity.user_picture.entity.uri.value) }}" alt="{{ node.uid.entity.name.value|default('Organizer') }}" />
            </div>
          {% endif %}
          <div class="organizer-info">
            <div class="organizer-label">Organiser</div>
            <div class="organizer-name">
              <a href="{{ path('entity.user.canonical', {'user': node.uid.target_id}) }}">
                {{ node.uid.entity.display_name.value|default(node.uid.entity.name.value|default('')) }}
              </a>
            </div>
          </div>
        </div>
      </footer>

    </div>

    {# ---------------- SIDEBAR ---------------- #}

    {% set ticket_choice = (node.field_ticket_type is defined and node.field_ticket_type.value)
      ? node.field_ticket_type.value|lower
      : '' %}
    {% set product = node.field_product_target.entity ?? null %}
    {% set variations = product ? product.getVariations() : [] %}
    {% set has_tickets = variations|length > 0 %}
    {% set show_rsvp = ticket_choice == 'rsvp' %}
    {% set show_cart = ticket_choice == 'paid' and has_tickets %}

    <aside class="event-sidebar event-sidebar--desktop">

      {% if mel_can_boost and not mel_is_boosted %}
        <div class="mel-boost-inline-cta" style="margin:12px 0 20px;">
          <a class="button button--primary" href="{{ path('myeventlane_boost.boost_page', {'node': node.id}) }}">
            Boost your event
          </a>
        </div>
      {% endif %}

      {% if mel_is_boosted %}
        <div class="mel-boost-status">
          <span class="mel-boost-badge"> Boosted</span>
          {% if mel_boost_expires %}
            <span class="mel-boost-expiry"> Until: {{ mel_boost_expires|date('j M Y ') }};<br>
            {{ mel_boost_days_left }} day{{ mel_boost_days_left == 1 ? '' : 's' }} left</span>
          {% endif %}
          {% if mel_is_boosted %}
            <br>
            <span class="mel-boost-expiry">
              <a href="{{ path('myeventlane_boost.boost_page', {'node': node.id}) }}" class="button button--ghost">Extend Boost</a>
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if show_rsvp %}
        <div class="sidebar-card">
          <h2 class="sidebar-cta-title">RSVP</h2>
          {% if event.field_limit_one_rsvp is defined and event.field_limit_one_rsvp.value and user_has_rsvped %}
            <p class="warning">You’ve already RSVP’d to this event.</p>
          {% else %}
            {{ drupal_form('Drupal\\myeventlane_rsvp\\Form\\RSVPSubmissionForm', node.id) }}
          {% endif %}
        </div>
      {% endif %}

      {% if show_cart %}
        <div class="sidebar-card">
          <h2 class="sidebar-cta-title">Buy Tickets</h2>
          {% for item in content.field_product_target['#items'] ?? [] %}
            {% set pid = item.target_id ?? null %}
            {% if pid %}
              <div class="event-actions" style="margin-bottom: 1rem;">
                {# Optional small heading using the product label: #}
                <div class="ticket-type-heading">{{ drupal_field('title', 'commerce_product', pid) }}</div>
                {{ drupal_field('variations', 'commerce_product', pid, 'add_to_cart') }}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% elseif ticket_choice == 'paid' and not has_tickets %}
        <div class="sidebar-card">
          <div class="cta-unavailable">Tickets are not available yet.</div>
        </div>
      {% endif %}


    </aside>
  </div>
</article>
