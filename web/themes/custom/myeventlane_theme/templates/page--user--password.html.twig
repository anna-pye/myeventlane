{{ attach_library('myeventlane_theme/auth') }}

<div class="mel-auth-page">
  <div class="mel-card mel-card--wide">
    <img class="mel-logo" src="{{ myeventlane_logo_src }}" alt="MyEventLane" />
    <h1 class="mel-auth-title">Let's reset your password</h1>
    <p class="mel-auth-subtitle">Enter your email and we'll send a reset link.</p>

    <div class="mel-auth-form-wrap">
      {{ page.content }}
    </div>

    <div class="mel-auth-meta">
      <a href="{{ path('user.login') }}">Back to login</a>
    </div>
  </div>
</div>

