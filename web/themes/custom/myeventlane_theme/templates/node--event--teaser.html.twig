{# web/themes/custom/myeventlane_theme/templates/node--event--teaser.html.twig #}
{# ---- Safe date + promo helpers ---- #}
{% set start_raw = node.field_event_date.value
  ?? node.field_event_date.0.value
  ?? node.field_start_date.value
  ?? node.field_start_date.0.value
  ?? null %}
{% set start_ts = start_raw ? (start_raw|date('U')) : 0 %}

{% set promo_expiry_ts = node.field_promo_expiry.value ? (node.field_promo_expiry.value|date('U')) : 0 %}
{% set now_ts = "now"|date('U') %}

<article class="event-card">
  <div class="event-card__image">
    {% if node.field_image.entity %}
      {# alt may be empty; provide a safe fallback #}
      <img src="{{ file_url(node.field_image.entity.uri.value) }}" alt="{{ node.field_image.alt|default(label) }}" />
    {% else %}
      <div class="event-card__placeholder"></div>
    {% endif %}

    {# Date badge (top left) #}
    <div class="event-card__date-overlay">
      <div class="event-card__month">{{ start_ts ? (start_ts|format_date('custom','M')) : '' }}</div>
      <div class="event-card__day">{{ start_ts ? (start_ts|format_date('custom','d')) : '' }}</div>
    </div>

    {# Boosted badge (top right) — safe numeric compare #}
      {% if mel_is_boosted %}
            <span class="mel-boost-chip" aria-label="Boosted"><span class="spark" aria-hidden="true"></span> 🌟 Boosted</span>
        {% endif %}
     </div>

 

  <div class="event-card__body">
    <h3 class="event-card__title">
      <a href="{{ url }}">{{ label }}</a>
    </h3>

    <div class="event-card__meta">
      <div>{{ start_ts ? (start_ts|format_date('custom','F j, Y')) : 'Date TBC' }}</div>
      {% if node.field_venue.value %}
        <div>{{ node.field_venue.value }}</div>
      {% endif %}
    </div>

    {% if node.field_category %}
      <div class="event-card__category">
        {% for term in node.field_category %}
          <a href="{{ path('entity.taxonomy_term.canonical', {'taxonomy_term': term.target_id}) }}">
            {{ term.entity.name.value }}
          </a>{% if not loop.last %} | {% endif %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="event-card__cta">
      {% if node.field_ticket_type.value == 'RSVP' %}
        <a href="{{ url }}" class="btn">RSVP</a>
      {% elseif node.field_ticket_type.value == 'Free' %}
        <a href="{{ url }}" class="btn">Free</a>
      {% else %}
        <a href="{{ url }}" class="btn">Buy Tickets</a>
      {% endif %}
    </div>
  </div>
</article>
