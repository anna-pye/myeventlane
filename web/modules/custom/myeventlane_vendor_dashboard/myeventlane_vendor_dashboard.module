<?php

use Drupal\profile\Entity\Profile;
use Drupal\commerce_store\Entity\Store;
use Drupal\user\Entity\User;

/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_dashboard.
 */

/**
 * Implements hook_preprocess_HOOK() for myeventlane_vendor_dashboard.
 */
function myeventlane_vendor_dashboard_preprocess_myeventlane_vendor_dashboard(&$variables) {
  $account = \Drupal::currentUser();
  $uid = $account->id();

  $profile_storage = \Drupal::entityTypeManager()->getStorage('profile');
  $profiles = $profile_storage->loadByProperties([
    'uid' => $uid,
    'type' => 'vendor_profile',
  ]);
  $profile = reset($profiles);

  if ($profile) {
    $variables['vendor_description'] = $profile->get('field_vendor_description')->value ?? '';

    if (!$profile->get('field_profile_image')->isEmpty()) {
      $variables['vendor_logo_url'] = $profile->get('field_profile_image')->entity->url();
    }

    $stripe_id = $profile->get('field_stripe_account_id')->value ?? '';
    $variables['stripe_account_id'] = $stripe_id;
    $variables['stripe_connected'] = !empty($stripe_id);
  }
}

/**
 * Implements hook_theme().
 */
function myeventlane_vendor_dashboard_theme($existing, $type, $theme, $path) {
  return [
    'myeventlane_vendor_dashboard' => [
      'variables' => ['cards' => []],
      'template' => 'vendor-dashboard',
    ],
    'myeventlane_vendor_dashboard_card' => [
      'variables' => [
        'title' => NULL,
        'type' => NULL,
        'image' => NULL,
        'venue' => NULL,
        'ticket_limit' => NULL,
        'count' => 0,
        'download_csv' => NULL,
        'view_rsvps_link' => NULL,
        'show_chart_btn' => NULL,
      ],
      'template' => 'vendor-dashboard-card',
    ],
  ];
}
