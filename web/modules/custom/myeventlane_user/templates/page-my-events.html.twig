
<div class="layout-wrapper">
  <div class="my-events-dashboard">
    <h1>My Events</h1>

    {% if rsvps or orders %}
      <div class="event-card-grid">
        {% for rsvp in rsvps %}
          {% set event = rsvp.field_rsvp_event.entity %}
          <div class="event-card">
            <h2>{{ event.label }}</h2>
            <p>Date: {{ event.field_event_date.value|date("M j, Y") }}</p>
            <span class="badge">RSVP</span>
            <a href="{{ path('entity.node.canonical', {'node': event.id()}) }}" class="btn">View Details</a>
            <a class="btn-secondary" href="/calendar-download/{{ event.id }}">Download .ics</a>
            <a href="/cancel-rsvp/{{ rsvp.id }}" class="btn-cancel" onclick="return confirm('Cancel this RSVP?');">Cancel RSVP</a>
          </div>
        {% endfor %}

        {% for order in orders %}
          {% set event_title = order.get('order_items').entity.label %}
          <div class="event-card">
            <h2>{{ event_title }}</h2>
            <p>Order ID: #{{ order.id() }}</p>
            <span class="badge">Ticket Purchase</span>
            <a href="{{ path('entity.commerce_order.canonical', {'commerce_order': order.id()}) }}" class="btn">View Ticket</a>
            <a class="btn-secondary" href="/calendar-download/{{ event.id }}">Download .ics</a>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="no-events-msg">You have no upcoming RSVPs or ticket purchases.</p>
    {% endif %}
  </div>
</div>
